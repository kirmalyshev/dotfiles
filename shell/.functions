#!/usr/bin/env zsh

# `.functions` provides helper functions for shell.


# === Commonly used functions ===

pyclean () {
  # Cleans py[cod] and cache dirs in the current tree:
  fd -I -H \
    '(__pycache__|\.(pytest_|mypy_)?cache|\.hypothesis\.py[cod]$)' \
  | xargs rm -rf
}


mcdir () {
  if [ $# -ne 1 ]; then
    echo 'usage: mcdir <dir-name>'
    return 137
  fi
  # Create a new directory and enter it
  local dir_name="$1"
  mkdir -p "$dir_name" && cd "$dir_name"
}


# === Agents ===
_claude_with_profile () {
  export CLAUDE_CONFIG_DIR="$1"
  command claude "${@:2}"
}

# Claude personal
function claude-personal() {
  _claude_with_profile "$HOME/.claude-personal" "$@"
}

# Claude work
function claude-work() {
  _claude_with_profile "$HOME/.claude-work" "$@"
}

# Claude sandbox
function claude-sandbox() {
  _claude_with_profile "$HOME/.claude-sandbox" "$@"
}

# Amp helper
_amp_with_config() {
  command amp --settings-file "$1" "${@:2}"
}

# Amp personal
function amp-personal() {
  _amp_with_config "$HOME/.amp/personal/config.yml" "$@"
}

# Amp cogram
function amp-cogram() {
  _amp_with_config "$HOME/.amp/cogram/config.yml" "$@"
}



# Cogram
alias cft='cloudflared tunnel run --token eyJhIjoiZjE5ZTBlYTdhM2U5ZmFlNWEyMDVmYWU5MTUyNDg2ZDIiLCJ0IjoiMzlhNGNlMjAtMWM0MC00ZTY4LTgyOWEtMTUwMjA2MDM4OWNkIiwicyI6Ik9HUXlaV05tWmpndE5tVmtNUzAwWXprekxUZzVZek10TkdSbU5XRXhOekk0WlRBeiJ9'

# custom tunnel 
cftp() {
  local port="${1:?usage: cftp <port>  (e.g. cftp 9010)}"
  if [[ "$port" != "8990" ]]; then
    if ! command -v socat >/dev/null; then echo "cftp: socat not installed"; return 1; fi
    socat TCP-LISTEN:8990,fork,reuseaddr TCP:localhost:"$port" &
    local bridge_pid=$!
    trap "kill $bridge_pid 2>/dev/null" EXIT INT TERM
    echo "cftp: yourhost.cogram.dev -> localhost:8990 (socat bridge) -> localhost:$port"
  fi
  cft
}

# === Running agents in docker containers ===

claude-docker () {
  # How it works:
  # 1. First run: the native installer drops the binary into ~/.local
  #    (volume `claude-bin`), then you go through the normal login /
  #    onboarding flow in the CLI.
  # 2. Everything Claude Code writes — auth, settings, .claude.json,
  #    session history, memory — lands in `claude-settings`, because
  #    CLAUDE_CONFIG_DIR redirects all of it there.
  # 3. Later runs: binary and config are already in the volumes, so no
  #    reinstall and no re-auth. `claude update` inside the container
  #    also persists, since it writes to ~/.local/share/claude.
  # 4. The project is mounted at its host path (not /workspace), so
  #    each repo keeps its own per-project sessions and memory.

  local project="$(readlink -f '.')"
  local image='buildpack-deps:bookworm-scm'  # has curl, git, bash

  docker run -it --rm \
    -e CLAUDE_CONFIG_DIR=/claude-config \
    -e PATH="/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    -v claude-settings:/claude-config \
    -v claude-bin:/root/.local \
    -v "$project":"$project" \
    -w "$project" \
    "$image" \
    bash -c '
      if [ ! -x "$HOME/.local/bin/claude" ]; then
        curl -fsSL https://claude.ai/install.sh | bash
      fi
      exec claude "$@"
    ' _ "$@"
}
