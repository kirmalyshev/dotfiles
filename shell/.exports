#!/usr/bin/env zsh

# `.exports` is used to provide custom variables.


# === Compiler flags ===

# This is required because `openssl` is keg-only in `brew`,
# see: `brew info openssl` for more information. On a machine without brew there
# is no keg to point at and the distro's own openssl is already discoverable, so
# there is nothing to set — and four `command not found` lines to avoid. Called
# once and reused: `brew --prefix` is a Ruby start-up, three times over.
if have brew; then
  brew_prefix="$(brew --prefix)"
  export LDFLAGS="-L$brew_prefix/opt/openssl/lib"
  export CPPFLAGS="-I$brew_prefix/opt/openssl/include"
  export PKG_CONFIG_PATH="$brew_prefix/opt/openssl/lib/pkgconfig"
fi

# Xcode's SDK, which only exists where Xcode does.
if have xcrun; then
  export CFLAGS="-I$(xcrun --show-sdk-path)/usr/include"
fi


# === Path modifications ===

# These lines should be the first ones!

# GPG agent:
PATH="/usr/local/opt/gpg-agent/bin:$PATH"

# Adds `pipx` binary files:
PATH="$HOME/.local/bin:$PATH"

# npm:
PATH="/usr/local/share/npm/bin:$PATH"

# JetBrains Toolbox CLI commands, from this checkout — which is not at that path
# on every machine, and does not exist at all on a headless one.
if [ -d "$HOME/Personal/repos/dotfiles/jetbrains" ]; then
  PATH="$HOME/Personal/repos/dotfiles/jetbrains:$PATH"
fi


# === General ===

# Editor. An empty EDITOR is worse than none: git and friends fall back to vi
# when it is unset, and error out when it is set to nothing.
if have nano; then
  export EDITOR="$(which nano)"
fi

# GPG:
export GPG_TTY="$(tty)"
if have gpg-agent; then
  eval "$(gpg-agent --daemon --allow-preset-passphrase > /dev/null 2>&1)"
fi

# Homebrew:
export HOMEBREW_NO_ANALYTICS=1  # disables statistics that brew collects
export HOMEBREW_NO_AUTO_UPDATE=1  # autoupdates break and slow down things

# Docker:
export DOCKER_CLI_HINTS=false  # disable ads in CLI :(

# Pagers:
# This affects every invocation of `less`.
#
#   -i       smart case-insensitive search
#   -R       color
#   -F       exit if there is less than one page of content
#   -X       keep content on screen after exit
#   -M       show more info at the bottom prompt line
#   -x4      tabs are 4 instead of 8
export LESS='-iRXFMx4 --mouse --wheel-lines=3'
export PAGER='less'
# I don't use `bat` here, because I don't like the highlight.
# sh -c 'col -b | bat -l man -p'
export MANPAGER='less'


# === Version managers ===

# nvm:
export NVM_DIR="$HOME/.nvm"
if have brew && [ -s "$brew_prefix/opt/nvm/nvm.sh" ]; then
  source "$brew_prefix/opt/nvm/nvm.sh"
fi




# === Histories ===

# Enable persistent REPL history for `node`.
export NODE_REPL_HISTORY="$HOME/.node_history"
# Use sloppy mode by default, matching web browsers.
export NODE_REPL_MODE='sloppy'

# Erlang and Elixir shell history:
export ERL_AFLAGS='-kernel shell_history enabled'

export PATH="$PATH:~/.lmstudio/bin"


# === Code highlight ===
# https://github.com/zsh-users/zsh-syntax-highlighting

# We won't highlight code longer than 200 chars, because it is slow:
export ZSH_HIGHLIGHT_MAXLENGTH=200


# Used by the two blocks above and nothing else; not left lying around in an
# interactive shell.
unset brew_prefix


# === PATH ===

# This should be the last line:
export PATH
