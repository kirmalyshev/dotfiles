#!/usr/bin/env python3
"""Regenerate the Brewfile from this machine's actual state, then open a PR.

`brew bundle dump` on its own produces an incomplete Brewfile here; the gaps it
leaves and the reasons for them are documented in AGENTS.md > Brewfile.

Usage: scripts/brew-dump [--no-pr | --self-check]
"""

import re
import subprocess
import sys
import tempfile
from datetime import date
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
BREWFILE = REPO / "Brewfile"
VSCODE_EXTENSIONS = Path.home() / ".vscode" / "extensions"
SECTIONS = ("tap", "brew", "cask", "mas", "vscode", "go", "uv", "npm")

# Entries `brew bundle dump` cannot see, so we carry them by hand:
#   - skhd is installed but koekeishiya/formulae is no longer tapped
#   - the casks are apps installed outside Homebrew, kept here so that
#     rebuilding a machine from this Brewfile reinstalls them
EXTRA = """
tap "koekeishiya/formulae"
# Simple hotkey-daemon for macOS
brew "koekeishiya/formulae/skhd"
# Password manager that keeps all passwords secure behind one password
cask "1password"
# Google Antigravity IDE
cask "antigravity"
# Remote desktop application
cask "anydesk"
# OpenAI's official ChatGPT desktop app
cask "chatgpt"
# Anthropic's official Claude AI desktop app
cask "claude"
# Web browser by Perplexity
cask "comet"
# AI-first code editor
cask "cursor"
# Universal database tool and SQL client
cask "dbeaver-community"
# Screen colour temperature controller
cask "flux-app"
# Web browser
cask "google-chrome"
# Writing assistant
cask "grammarly-desktop"
# Knowledge base on top of a local folder of plain text Markdown files
cask "obsidian"
# Control your tools with a few keystrokes
cask "raycast"
# Mesh VPN based on WireGuard
cask "tailscale-app"
# Messaging app with a focus on speed and security
cask "telegram"
# Open-source code editor
cask "visual-studio-code"
# Voice dictation app
cask "wispr-flow"
# Gecko based web browser
cask "zen"
# Video communication and virtual meeting platform
cask "zoom"
# Collect, organise, cite, and share research sources
cask "zotero"
"""


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, cwd=REPO, **kwargs)


def parse(text):
    """Split Brewfile text into (comment lines + entry) blocks, keyed by type."""
    blocks = {section: [] for section in SECTIONS}
    comments = []
    for line in text.splitlines():
        if line.startswith("#"):
            comments.append(line)
            continue
        match = re.match(r'(\w+) +"([^"]+)"', line)
        if not match:
            comments = []
            continue
        kind, name = match.groups()
        if kind in blocks:
            blocks[kind].append((name.lower(), comments + [line]))
        comments = []
    return blocks


def vscode_extensions():
    """Read VS Code's own extensions.

    `brew bundle dump` shells out to a `code` binary. There is none on this
    machine, so it reports Cursor's extension list instead of VS Code's.
    """
    if not VSCODE_EXTENSIONS.is_dir():
        return []
    names = {
        re.sub(r"-\d+\.\d+\.\d+.*$", "", path.name)
        for path in VSCODE_EXTENSIONS.iterdir()
        if path.is_dir()
    }
    return [(name.lower(), [f'vscode "{name}"']) for name in names]


def render(blocks):
    out = []
    for section in SECTIONS:
        entries, seen = [], set()
        for name, lines in sorted(blocks[section]):
            if name not in seen:
                seen.add(name)
                entries.extend(lines)
        if entries:
            out.extend(entries + [""])
    return "\n".join(out).rstrip() + "\n"


def dump():
    with tempfile.NamedTemporaryFile(suffix="-Brewfile") as tmp:
        run("brew", "bundle", "dump", "--force", f"--file={tmp.name}")
        blocks = parse(Path(tmp.name).read_text())
    for section, extra in parse(EXTRA).items():
        blocks[section].extend(extra)
    blocks["vscode"] = vscode_extensions() or blocks["vscode"]
    return render(blocks)


def origin_repo():
    """`owner/name` of the `origin` remote.

    Passed to `gh` explicitly: this repository is a fork, and `gh pr create`
    otherwise defaults its base to the parent repository.
    """
    url = run("git", "remote", "get-url", "origin",
              capture_output=True).stdout.strip()
    return re.sub(r"^.*[:/]([^/]+/[^/]+?)(\.git)?$", r"\1", url)


def open_pr():
    branch = f"brew-dump-{date.today():%Y%m%d}"
    original = run("git", "rev-parse", "--abbrev-ref", "HEAD",
                   capture_output=True).stdout.strip()
    run("git", "checkout", "-B", branch)
    try:
        run("git", "add", "Brewfile")
        run("git", "commit", "-m", "Brewfile: sync with actual machine state",
            "-m", "Regenerated by scripts/brew-dump.")
        run("git", "push", "--force-with-lease", "-u", "origin", branch)
        pr = subprocess.run(
            ["gh", "pr", "create", "--fill",
             "--repo", origin_repo(), "--base", original, "--head", branch],
            text=True, cwd=REPO, capture_output=True,
        )
        # `gh pr create` fails when a PR for this branch is already open;
        # the push above has already updated it, so that is not an error.
        print(pr.stdout or pr.stderr, end="")
    finally:
        run("git", "checkout", original)


def self_check():
    blocks = parse(EXTRA + '\nbrew "koekeishiya/formulae/skhd"\n')
    assert [name for name, _ in blocks["tap"]] == ["koekeishiya/formulae"], blocks
    rendered = render(blocks)
    assert rendered.count('brew "koekeishiya/formulae/skhd"') == 1, "not deduplicated"
    assert '# Simple hotkey-daemon for macOS\nbrew "koekeishiya' in rendered, rendered
    assert rendered.index('cask "1password"') < rendered.index('cask "zoom"'), "unsorted"
    assert rendered.index('tap "koekeishiya') < rendered.index('brew "koekeishiya'), "misgrouped"
    print("self-check ok")


def main():
    if "--self-check" in sys.argv:
        return self_check()

    current = BREWFILE.read_text() if BREWFILE.exists() else ""
    updated = dump()
    if updated == current:
        print("Brewfile already matches this machine.")
        return
    BREWFILE.write_text(updated)
    print(f"Brewfile updated ({len(updated.splitlines())} lines).")
    if "--no-pr" not in sys.argv:
        open_pr()


if __name__ == "__main__":
    main()
