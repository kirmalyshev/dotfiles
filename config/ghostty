# Ghostty terminal configuration
# Ported from Ghostty settings

theme = Adventure

# Font settings
font-family = Menlo
font-size = 12
font-style = normal
font-style-bold = bold

# Cursor
cursor-color = #f81ce5
cursor-style = block
cursor-style-blink = false

# Window padding
window-padding-x = 14
window-padding-y = 12

# Keybindings
keybind = alt+backspace=text:\x1b\x7f
keybind = cmd+shift+r=prompt_surface_title
