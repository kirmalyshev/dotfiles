# LifeOS statusline level (min | compact | mid | full)
# Writes the state file that ~/.claude/statusline-collapse.sh reads each render.
lifeos-sl() {
    local d="$HOME/.claude/LIFEOS/MEMORY/STATE"
    case "${1:-}" in
        min|compact|mid|full)
            mkdir -p "$d" && printf '%s\n' "$1" > "$d/statusline-level"
            echo "LifeOS statusline: $1" ;;
        ""|status) echo "LifeOS statusline: $(cat "$d/statusline-level" 2>/dev/null || echo compact)" ;;
        *) echo "usage: lifeos-sl [min|compact|mid|full|status]" ; return 1 ;;
    esac
}
lifeos-collapse() { lifeos-sl min; }
lifeos-expand()   { lifeos-sl full; }
lifeos-toggle() {
    local f="$HOME/.claude/LIFEOS/MEMORY/STATE/statusline-level"
    [ "$(cat "$f" 2>/dev/null)" = "full" ] && lifeos-sl compact || lifeos-sl full
}
# muscle-memory aliases from PAI
