# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# Uncomment the following line to use case-sensitive completion.
CASE_SENSITIVE='false'

# Uncomment the following line to use hyphen-insensitive completion. Case
# sensitive completion must be off. _ and - will be interchangeable.
HYPHEN_INSENSITIVE='false'

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="false"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# The optional three formats: "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
HIST_STAMPS='yyyy-mm-dd'

# Commands starting from " " (whitespace) won't be saved in history:
HIST_IGNORE_SPACE='true'

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.

# `brew`, `iterm2` and `macos` are added below, on macOS only: each defines
# completions or functions for something a Linux box does not have.
plugins=(
  aliases
  colored-man-pages
  colorize
  cp
  docker docker-compose
  dotenv
  git
  gitfast
  gh
  github
  golang
  helm
  history
  node
  pip
  python
  ssh
  sublime
  wd
  uv
)

if is_macos; then
  plugins+=(brew iterm2 macos)
fi

# Sourcing the Oh-My-ZSH source:
source "$ZSH/oh-my-zsh.sh"

# This PATH needs to be set before all other modifications. It REPLACES what
# came before, deliberately: /etc/paths and every installer prepends, and this is
# the one place that decides the order. That only makes sense on a Mac — on Linux
# there is no /opt/homebrew, and a reset drops what the distro put there and
# nothing puts back (/snap/bin, ~/.local/bin, /usr/games).
if is_macos; then
  export PATH='/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin'
fi


# === Shell parts ===

source "$HOME/.shell/.std"  # should be the first one
source "$HOME/.shell/.exports"
source "$HOME/.shell/.aliases"
source "$HOME/.shell/.functions"
source "$HOME/.shell/.external"
source "$HOME/.shell/.completions"

# === Local variables and overrides ===

if [[ -f "$HOME/.shell_env_local" ]]; then
  source "$HOME/.shell_env_local"
fi

# Appended by various installers, each with this Mac's home path written out and
# each prepending a directory that exists on one machine. Collapsed into one loop
# over $HOME, skipping what is not there — Antigravity was in here twice.
for _bin in \
  "$HOME/.antigravity/antigravity/bin" \
  "$HOME/.amp/bin" \
  "$HOME/.maestro/bin" \
  "$HOME/.lmstudio/bin"
do
  [ -d "$_bin" ] && export PATH="$_bin:$PATH"
done
unset _bin

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"


# PAI Configuration (added by Kai Bundle installer)
export DA="Krot"
export TIME_ZONE="Europe/Berlin"
export PAI_SOURCE_APP="$DA"



# LifeOS statusline level (bare | min | compact | mid | full)
# Writes the state file that ~/.claude/statusline-collapse.sh reads each render.
lifeos-sl() {
    local d="$HOME/.claude/LIFEOS/MEMORY/STATE"
    case "${1:-}" in
        bare|min|compact|mid|full)
            mkdir -p "$d" && printf '%s\n' "$1" > "$d/statusline-level"
            echo "LifeOS statusline: $1" ;;
        ""|status) echo "LifeOS statusline: $(cat "$d/statusline-level" 2>/dev/null || echo compact)" ;;
        *) echo "usage: lifeos-sl [bare|min|compact|mid|full|status]" ; return 1 ;;
    esac
}
lifeos-collapse() { lifeos-sl min; }
lifeos-expand()   { lifeos-sl full; }
lifeos-toggle() {
    local f="$HOME/.claude/LIFEOS/MEMORY/STATE/statusline-level"
    [ "$(cat "$f" 2>/dev/null)" = "full" ] && lifeos-sl bare || lifeos-sl full
}
# muscle-memory aliases from PAI
pai-collapse() { lifeos-collapse; }
pai-expand()   { lifeos-expand; }
pai-toggle()   { lifeos-toggle; }


[ -r "$HOME/.daytona.completion_script.zsh" ] && source "$HOME/.daytona.completion_script.zsh"

# Added by PAI installer — make bun reachable for hook subprocesses
export PATH="$HOME/.bun/bin:$PATH"

# PAI alias
alias pai='bun $HOME/.claude/PAI/Tools/pai.ts'


# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# ponytail (lazy-mode skill) default level
export PONYTAIL_DEFAULT_MODE=full

# Added by Antigravity IDE
[ -d "$HOME/.antigravity-ide" ] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
have direnv && eval "$(direnv hook zsh)"
